# Plantilla de nginx: la imagen oficial reemplaza ${BACKEND_ORIGIN} y ${PROXY_SECRET} con las variables de entorno al
# arrancar (solo las definidas; las variables propias de nginx, como $host, no se tocan).
# - Docker Compose: BACKEND_ORIGIN=http://backend:8080 y PROXY_SECRET vacía.
# - Render: BACKEND_ORIGIN=https://<backend>.onrender.com y PROXY_SECRET compartida con el backend (ver ADR-020).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    # No anunciar la versión de nginx en errores ni en la cabecera Server.
    server_tokens off;

    # Margen sobre el límite de 5 MB por imagen que valida el backend.
    client_max_body_size 6m;

    # IP real del visitante: en Render (y en el puerto publicado por Docker) la conexión llega desde un proxy de red
    # privada que agrega X-Forwarded-For. Se confía solo en esos rangos; un X-Forwarded-For que mande el cliente queda a la
    # izquierda y se ignora.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Spring Security también envía estas tres: se ocultan las del backend para que la respuesta lleve una sola copia.
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;

    # Encabezados hacia el backend. X-Forwarded-For se reemplaza (no se concatena) con la IP real y se borran los que el
    # cliente podría falsear (Forwarded, X-Forwarded-Host/Port/Prefix). X-Client-Ip con X-Proxy-Secret le dice al backend
    # la IP del visitante cuando llega por internet (Render); sin la clave, el backend lo ignora.
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-Port "";
    proxy_set_header X-Forwarded-Prefix "";
    proxy_set_header X-Client-Ip $remote_addr;
    proxy_set_header X-Proxy-Secret "${PROXY_SECRET}";
    proxy_ssl_server_name on;
    # El backend del plan gratis de Render tarda cerca de un minuto en despertar.
    proxy_connect_timeout 90s;
    proxy_read_timeout 120s;

    # El formulario público de cotización es JSON pequeño: un cuerpo mayor se rechaza antes de llegar al backend.
    location = /api/v1/quotes {
        client_max_body_size 64k;
        proxy_pass ${BACKEND_ORIGIN};
    }

    location /api/ {
        proxy_pass ${BACKEND_ORIGIN};
    }

    location /media/ {
        proxy_pass ${BACKEND_ORIGIN};
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        # Un archivo de una versión anterior que ya no existe responde 404, no la página principal.
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
    }
}
