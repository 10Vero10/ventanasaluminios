# Copia este archivo como .env y cambia los valores. El .env real nunca se sube al repositorio.

# PostgreSQL
POSTGRES_DB=ventanas
POSTGRES_USER=ventanas
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_PORT=5432

# Puerto donde se publica el sitio (nginx)
WEB_PORT=8080

# pgAdmin (opcional: docker compose --profile tools up)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=cambiar-esta-clave
PGADMIN_PORT=5050
