# Copia este archivo como .env y cambia los valores. El .env real nunca se sube al repositorio.

# PostgreSQL
POSTGRES_DB=ventanas
POSTGRES_USER=ventanas
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_PORT=5432

# Sesión del panel: clave para firmar los JWT (mínimo 32 caracteres; genera una con `openssl rand -base64 48`).
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria-de-al-menos-32-caracteres
# Duración de la sesión y cookie Secure (localhost cuenta como seguro; déjalo en true salvo que uses otra IP sin HTTPS).
AUTH_SESSION_DURATION=8h
AUTH_COOKIE_SECURE=true

# Primer administrador: se crea al arrancar si no existe ninguno y debe cambiar la contraseña en el primer ingreso.
# Después del primer ingreso puedes borrar ADMIN_INITIAL_PASSWORD (deja ADMIN_EMAIL); solo se usa si no hay administradores.
ADMIN_EMAIL=admin@ventanasyaluminios.com
ADMIN_INITIAL_PASSWORD=cambiar-esta-clave-temporal

# Puerto donde se publica el sitio (nginx)
WEB_PORT=8080

# pgAdmin (opcional: docker compose --profile tools up)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=cambiar-esta-clave
PGADMIN_PORT=5050
