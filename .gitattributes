# Normaliza finales de línea: LF en el repo, el sistema decide al hacer checkout.
* text=auto

# Scripts que deben conservar su formato en cualquier sistema operativo.
mvnw text eol=lf
*.sh text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binarios
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
